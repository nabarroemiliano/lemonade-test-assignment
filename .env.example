# Base URL of the system under test. The trailing slash matters: QuotePage.open()
# navigates to the relative path "quotes/<id>", and without it Playwright's URL
# resolution would drop the /qa-interview-task prefix.
BASE_URL=https://lemonade-hq.github.io/qa-interview-task/

# Identifier of the quote the suite exercises.
QUOTE_ID=LQ42EE07089
