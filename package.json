{
  "name": "lemonade-test-assignment",
  "version": "1.0.0",
  "description": "End-to-end test framework for the Lemonade renters quote page using Playwright + TypeScript with Allure reporting.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test",
    "report": "allure generate ./allure-results -o ./allure-report --clean && allure open ./allure-report",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "e2e",
    "typescript",
    "allure",
    "lemonade"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.8.7",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "dotenv": "17.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
